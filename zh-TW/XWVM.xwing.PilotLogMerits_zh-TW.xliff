	<unit id="PilotLog.Stats.TitleLine1" >
		<notes>
			<note>The (* and *) represent highlight in bold.</note>
		</notes>
        <segment>
          <source>(*{pilotRank}*) {pilotName}</source>
          <target>(*{pilotRank}*) {pilotName}</target>
        </segment>
	</unit>
	<unit id="PilotLog.Stats.TitleLine2" >
		<notes>
			<note>The (* and *) represent highlight in bold. [[ and ]] represent highlight in white.</note>
		</notes>
        <segment>
          <source>(*{pilotStatus}*) with (*[[{score}]]*) Tour of Duty points</source>
          <target>(*{pilotStatus:choose(Alive|Dead|Captured):現役|陣亡|被俘}*)，戰役積分：(*[[{score}]]*)</target>
        </segment>
	</unit>
